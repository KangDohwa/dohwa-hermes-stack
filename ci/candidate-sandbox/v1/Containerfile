FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY reviewer/requirements.executor.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt \
    && useradd --uid 65532 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin candidate \
    && mkdir -p /opt/dohwa/bin \
    && chmod 0755 /opt/dohwa /opt/dohwa/bin

COPY --chmod=0555 ci/candidate-sandbox/v1/probe_runtime.py /opt/dohwa/bin/probe-runtime

USER 65532:65532
