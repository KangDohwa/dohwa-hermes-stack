FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN groupadd --gid 1001 reviewer \
    && useradd --uid 1001 --gid reviewer --no-create-home --shell /usr/sbin/nologin reviewer

WORKDIR /app

COPY reviewer/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY --chown=1001:1001 reviewer /app/reviewer

USER 1001:1001

EXPOSE 8080

CMD ["uvicorn", "reviewer.orchestrator:app", "--host", "0.0.0.0", "--port", "8080"]
